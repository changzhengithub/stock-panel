# Free public data is the default; no token needed. Use tushare to opt in.
DATA_PROVIDER=free
FREE_MIN_INTERVAL=0.35
TUSHARE_TOKEN=
# Path relative to repository root, or an absolute path.
STOCK_DB_PATH=data/stock-panel.sqlite3
TUSHARE_MIN_INTERVAL=1.3

# Current free quotes run automatically with the web service; 0 only for offline tests.
REALTIME_QUOTES=1
# 免费热门板块自动采集；0 关闭，手动 sync-fund-flow 仍可用
FUND_FLOW_ENABLED=1

# 全行业业务/分部资料自动更新，校验后整批切换；服务运行时生效
CHAIN_AUTO_UPDATE=1
CHAIN_UPDATE_INTERVAL_HOURS=24
# 默认沿用环境代理；1 表示公开数据接口直接联网
CHAIN_UPDATE_DIRECT_NETWORK=0
